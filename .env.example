# Copia este archivo a .env y llena tus valores reales. Nunca subas .env a git.
DATABASE_URL=postgresql+asyncpg://familias_user:familias_pass@db:5432/familias_que_suman

# Usado por Alembic para migraciones (conexión sincrona)
DATABASE_URL_SYNC=postgresql+psycopg2://familias_user:familias_pass@db:5432/familias_que_suman

JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# API key del proveedor de LLM para el chatbot (console de Google AI Studio)
GEMINI_API_KEY=key
GEMINI_MODEL=gemini-2.5-flash-lite

S3_ACCESS_KEY=cambia-este-usuario
S3_SECRET_KEY=cambia-esta-clave-larga

# Grafana (se usa al levantar el perfil monitoreo)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-por-una-clave-unica-y-larga