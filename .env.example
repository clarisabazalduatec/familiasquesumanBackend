# Copia este archivo a .env y llena tus valores reales. Nunca subas .env a git.
# Genera cada secreto con:  openssl rand -hex 32

# "dev" en tu compu; "prod" en el servidor (apaga /docs, exige secretos fuertes, bloquea la semilla)
ENTORNO=dev

# --- Base de datos ---
# La API usa un rol SIN permisos de DDL (familias_app). Créalo una vez con scripts/rol_app.sql.
# Mientras no lo crees, puedes dejar familias_user aquí (funciona, pero con más permisos de los necesarios).
DATABASE_URL=postgresql+asyncpg://familias_app:cambia-esta-clave-del-rol-app@db:5432/familias_que_suman
# Alembic (migraciones) y la semilla usan el dueño de las tablas
DATABASE_URL_SYNC=postgresql+psycopg2://familias_user:cambia-esta-clave-de-postgres@db:5432/familias_que_suman
POSTGRES_PASSWORD=cambia-esta-clave-de-postgres

# --- Sesión ---
# Mínimo 32 caracteres aleatorios (en ENTORNO=prod la API no arranca con uno más corto)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# 1 día. La app pide iniciar sesión de nuevo al vencer.
JWT_EXPIRE_MINUTES=1440

# --- Rate limiting ---
# Solo si TODO el tráfico entra por Cloudflare: IP_HEADER=cf-connecting-ip. Si no, déjalo vacío.
IP_HEADER=
RATE_LIMIT_DEFAULT=300/minute
LOGIN_MAX_FALLOS=5
LOGIN_BLOQUEO_MINUTOS=15

# --- Chatbot ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# true = descarta turnos "asistente" del historial que no traigan la firma del backend.
# Ponlo en false SOLO mientras la app no mande la firma.
CHAT_EXIGIR_FIRMA=true

# --- Almacén de imágenes ---
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Formulario de contacto (sin estas, /contacto responde 503) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACTO_DESTINATARIO=

# --- Semilla (solo desarrollo; mínimo 12 caracteres). No se imprime al crear el admin. ---
SEED_ADMIN_PASSWORD=

# --- Grafana (perfil monitoreo) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
